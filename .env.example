# Runtime Postgres connection (pooled in hosted environments). Required for sign-in.
DATABASE_URL=postgres://oneauth:oneauth@localhost:5432/oneauth_dev
# Optional direct connection for migrations (advisory locks need a session).
# DATABASE_URL_UNPOOLED=
# Optional PEM CA bundle if the provider's TLS certificate isn't publicly trusted.
# DATABASE_CA_CERT=
# Trusted WebAuthn origins, comma-separated; the first is canonical and other hosts redirect to it.
# localhost:3000 is allowed automatically outside production. Hosted deployments MUST set this.
ONEAUTH_ORIGINS=
# Optional WebAuthn RP ID: a parent domain of every origin (e.g. oneauth.example for https://app.oneauth.example).
# ONEAUTH_RP_ID=
# Production only: must be "production" for a production build to use DATABASE_URL.
# ONEAUTH_DATABASE_ENV=
